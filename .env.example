# Copy this file to .env and fill in real values before running locally.
DEEPSEEK_API_KEY=your_api_key_here
DATABASE_URL=sqlite:///data/ai_teacher.db
DEFAULT_STUDENT_ID=TestUser
LIVEKIT_WS_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
VOICE_DEFAULT_ROOM=ai-teacher-room
TTS_ENABLED=true
TTS_PROVIDER=doubao
TTS_BASE_URL=http://127.0.0.1:8012
TTS_DEFAULT_VOICE=melo_teacher
TTS_DEFAULT_LANG=zh
TTS_DEFAULT_SPEED=1.0
TTS_TIMEOUT_SECONDS=120
DOUBAO_TTS_API_VERSION=v3
DOUBAO_AUTH_MODE=api_key
DOUBAO_API_KEY=
DOUBAO_APP_ID=your_doubao_app_id
DOUBAO_ACCESS_TOKEN=your_doubao_access_token
DOUBAO_TTS_V3_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/bidirection

# -- Legacy V1 only -------------------------------------------------
# DOUBAO_CLUSTER / DOUBAO_APP_ID / DOUBAO_ACCESS_TOKEN are retained
# for DOUBAO_TTS_API_VERSION=v1 or DOUBAO_AUTH_MODE=app_token.
# V3 uses DOUBAO_TTS_RESOURCE_ID instead.
DOUBAO_CLUSTER=volcano_tts

# -- Doubao V3 voice ------------------------------------------------
# The current voice from the new Doubao voice library / voice design
# system should be sent as voice_type / speaker in the V3 request.
DOUBAO_TTS_VOICE=your_doubao_voice_type
DOUBAO_TTS_VOICE_TYPE=
DOUBAO_TTS_SPEAKER_ID=

# -- Doubao V3 resource ID ------------------------------------------
# The accepted resource for the current verified voice is seed-icl-2.0.
DOUBAO_TTS_RESOURCE_ID=seed-icl-2.0
DOUBAO_TTS_RESOURCE_ID_HEADER=X-Api-Resource-Id
DOUBAO_TTS_MODEL=
DOUBAO_TTS_ENABLE_STREAM=true

# Only fallback to local MeloTTS when doubao fails if set to true.
# Keep false during debugging to see raw doubao errors.
TTS_FALLBACK_ON_ERROR=false

# Legacy local Melo/OpenVoice fallback example:
# TTS_PROVIDER=local_melo
# TTS_BASE_URL=http://127.0.0.1:8012
#
# Never commit real DOUBAO_API_KEY, Access Token, or LiveKit secrets.
# Put real secrets only in .env, which is ignored by Git.
FUNASR_WS_URL=wss://127.0.0.1:10095
FUNASR_MODE=2pass
FUNASR_MODEL_NAME=
FUNASR_CHUNK_SIZE=5,8,4
FUNASR_CHUNK_INTERVAL=8
FUNASR_FINAL_WAIT_OFFLINE_MS=5000
FUNASR_FINAL_WAIT_FALLBACK_MS=1000
FUNASR_FINAL_DRAIN_WINDOW_MS=4000
FUNASR_FINAL_RESCUE_WAIT_MS=6000
FUNASR_LATE_FINAL_GRACE_MS=12000
FUNASR_FALLBACK_MIN_STABLE_MS=240
SILERO_SAMPLE_RATE=16000
SILERO_CHANNELS=1
SILERO_VAD_THRESHOLD=0.38
SILERO_MIN_SILENCE_MS=1200
SILERO_PRE_SPEECH_MS=480
SILERO_MIN_SPEECH_MS=320
SILERO_SPEECH_END_HOLD_MS=720
VOICE_DEBUG_FORCE_SEGMENT_MODE=false
VOICE_DEBUG_FORCE_SEGMENT_MS=3000
